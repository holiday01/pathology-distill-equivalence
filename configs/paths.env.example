# Copy to configs/paths.env and edit, then: source configs/paths.env
# Nothing here is read automatically — the scripts take explicit paths on the
# command line. This file exists so the substitutions are recorded in one place.

# --- raw whole-slide image cohorts (bulk / cold storage) -------------------
export WSI_ROOT=/path/to/wsi_datasets
export WSI_TCGA_DIR=$WSI_ROOT/tcga
export WSI_C16_DIR=$WSI_ROOT/camelyon16
export WSI_EXTERNAL_DIR=$WSI_ROOT/external

# --- fast local cache: HDF5 patch bundles and cached teacher features ------
# This should be on the fastest disk you have; the atlas reads it constantly.
export WSI_CACHE_DIR=/path/to/cache
export WSI_PATCH_CACHE=$WSI_CACHE_DIR/patches
export WSI_FEATURE_CACHE=$WSI_CACHE_DIR/features

# --- this repository -------------------------------------------------------
export WSI_PROJ=/path/to/wsi_hl
